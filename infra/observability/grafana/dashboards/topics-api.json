{
  "uid": "topics-api-nfr",
  "title": "topics-api / NFR baseline",
  "tags": ["modernization", "topics-api"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_server_requests_seconds_count, env)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Scrape target up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"topics-api\"}", "legendFormat": "up" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 2, "type": "stat", "title": "Requests / s",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{env=~\"$env\"}[1m]))", "legendFormat": "rps" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 3, "type": "stat", "title": "p95 latency",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{env=~\"$env\", uri!~\"/manage.*|/actuator.*\"}[1m])))", "legendFormat": "p95" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.25 }, { "color": "red", "value": 0.5 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 4, "type": "stat", "title": "5xx ratio",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "(sum(rate(http_server_requests_seconds_count{env=~\"$env\", status=~\"5..\"}[1m])) or vector(0)) / sum(rate(http_server_requests_seconds_count{env=~\"$env\"}[1m]))", "legendFormat": "5xx" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 5, "type": "stat", "title": "Hikari pool max",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "max(hikaricp_connections_max{env=~\"$env\"})", "legendFormat": "max" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 20 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Latency percentiles (non-actuator)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, env) (rate(http_server_requests_seconds_bucket{env=~\"$env\", uri!~\"/manage.*|/actuator.*\"}[1m])))", "legendFormat": "p50 {{env}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, env) (rate(http_server_requests_seconds_bucket{env=~\"$env\", uri!~\"/manage.*|/actuator.*\"}[1m])))", "legendFormat": "p95 {{env}}" },
        { "expr": "histogram_quantile(0.99, sum by (le, env) (rate(http_server_requests_seconds_bucket{env=~\"$env\", uri!~\"/manage.*|/actuator.*\"}[1m])))", "legendFormat": "p99 {{env}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 7, "type": "timeseries", "title": "Throughput by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{env=~\"$env\", uri!~\"/manage.*|/actuator.*\"}[1m]))", "legendFormat": "{{uri}} {{status}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 8, "type": "timeseries", "title": "Hikari connections (active / pending / max)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (env) (hikaricp_connections_active{env=~\"$env\"})", "legendFormat": "active {{env}}" },
        { "expr": "sum by (env) (hikaricp_connections_pending{env=~\"$env\"})", "legendFormat": "pending {{env}}" },
        { "expr": "max by (env) (hikaricp_connections_max{env=~\"$env\"})", "legendFormat": "max {{env}}" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 9, "type": "timeseries", "title": "Hikari acquire time p95",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (env) (rate(hikaricp_connections_acquire_seconds_sum{env=~\"$env\"}[1m])) / sum by (env) (rate(hikaricp_connections_acquire_seconds_count{env=~\"$env\"}[1m]))", "legendFormat": "avg acquire {{env}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 10, "type": "timeseries", "title": "JVM heap used / max",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (env) (jvm_memory_used_bytes{env=~\"$env\", area=\"heap\"})", "legendFormat": "used {{env}}" },
        { "expr": "sum by (env) (jvm_memory_max_bytes{env=~\"$env\", area=\"heap\"})", "legendFormat": "max {{env}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 11, "type": "timeseries", "title": "Tomcat busy threads / log events per second",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (env) (tomcat_threads_busy_threads{env=~\"$env\"})", "legendFormat": "busy threads {{env}}" },
        { "expr": "sum by (env) (rate(logback_events_total{env=~\"$env\"}[1m]))", "legendFormat": "log events/s {{env}}" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 12, "type": "timeseries", "title": "GC pause time / s",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (env) (rate(jvm_gc_pause_seconds_sum{env=~\"$env\"}[1m]))", "legendFormat": "gc {{env}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    }
  ]
}
